# Credentials and keys. Never commit these.
*.pem
*.key
*.ppk
.env
.env.*
wp-config.php
credentials
secrets.*

# WordPress runtime. The theme is versioned, the installation is not.
wp-admin/
wp-includes/
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/plugins/

# Database and backup artefacts.
*.sql
*.sql.gz
*.tar.gz
*.zip

# Local tooling.
node_modules/
vendor/
.DS_Store
*.log

# Agent working file.
IMPLEMENT.md

# Design export. 17M of binaries, mostly PNG, stays out. The _ds token sheet is
# ~30KB and PLAN.md calls it the locked source of truth for every colour, font,
# and spacing value, so it has to survive a clone.
#
# Note the trailing /* rather than a bare design/. Git never descends into an
# excluded directory, so a bare `design/` makes `!design/_ds/` a no-op: the
# negation is unreachable and the tokens stay ignored with no warning.
# `design/*` excludes the entries inside design/ individually, which leaves the
# negation able to re-include one of them.
design/*
!design/_ds/
